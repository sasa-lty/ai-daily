{
  "name": "ai-daily-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "个人 AI 日报雷达：静态网页 + RSS 每日自动更新 + GitHub Pages 部署",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "update": "tsx scripts/update-daily.ts",
    "update:arena": "tsx scripts/update-arena.ts",
    "update:all": "tsx scripts/update-daily.ts && tsx scripts/update-arena.ts"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fast-xml-parser": "^4.5.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
